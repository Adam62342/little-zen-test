[
  {
    "type": "text",
    "label": "**Little Zen**",
    "size": "18px"
  },
  {
    "type": "text",
    "label": "Opens links from other apps in a small floating window, Arc-style. Settings below take effect for the next little window you open."
  },
  {
    "type": "separator",
    "label": "Behaviour"
  },
  {
    "type": "checkbox",
    "label": "Enable Little Zen (route external links to a little window)",
    "property": "littlezen.enabled",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Swipe back to close when there's no page to go back to",
    "property": "littlezen.swipe-to-close",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Close the little window when I press *Escape*",
    "property": "littlezen.escape-to-close",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Dim the little window when it loses focus",
    "property": "littlezen.dim-inactive",
    "defaultValue": true
  },
  {
    "type": "dropdown",
    "label": "Which swipe direction means *back*",
    "property": "littlezen.back-direction",
    "defaultValue": "right",
    "options": [
      { "label": "Swipe right (macOS default)", "value": "right" },
      { "label": "Swipe left", "value": "left" }
    ]
  },
  {
    "type": "separator",
    "label": "Size & feel"
  },
  {
    "type": "string",
    "label": "Little window width (px)",
    "property": "littlezen.width",
    "defaultValue": "480",
    "placeholder": "480"
  },
  {
    "type": "string",
    "label": "Little window height (px)",
    "property": "littlezen.height",
    "defaultValue": "640",
    "placeholder": "640"
  },
  {
    "type": "string",
    "label": "How far to swipe before it closes (0.1 = easy, 0.5 = deliberate)",
    "property": "littlezen.swipe-threshold",
    "defaultValue": "0.25",
    "placeholder": "0.25"
  }
]
